@import "tailwindcss";

:root {
  --background: #080b12;
  --panel: rgba(13, 18, 29, 0.78);
  --panel-strong: rgba(17, 24, 39, 0.92);
  --border: rgba(148, 163, 184, 0.18);
  --text-primary: #f8fafc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --accent: #2dd4bf;
  --accent-strong: #14b8a6;
  --accent-warm: #f59e0b;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
  background: var(--background);
}

body {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    linear-gradient(rgba(148, 163, 184, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148, 163, 184, 0.045) 1px, transparent 1px),
    radial-gradient(circle at 20% 0%, rgba(45, 212, 191, 0.12), transparent 34%),
    radial-gradient(circle at 85% 10%, rgba(245, 158, 11, 0.1), transparent 30%),
    #080b12;
  background-size: 44px 44px, 44px 44px, auto, auto, auto;
  color: var(--text-primary);
  font-family: var(--font-body, system-ui, -apple-system, sans-serif);
}

::selection {
  background: rgba(45, 212, 191, 0.24);
  color: #ffffff;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-display, system-ui, sans-serif);
  letter-spacing: 0;
}

a,
button,
input,
textarea {
  transition:
    color 180ms ease,
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease,
    opacity 180ms ease;
}

.section-shell {
  position: relative;
  overflow: hidden;
  border-top: 1px solid var(--border);
  background:
    linear-gradient(180deg, rgba(15, 23, 42, 0.76), rgba(8, 11, 18, 0.94)),
    transparent;
}

.section-inner {
  position: relative;
  z-index: 1;
  margin: 0 auto;
  max-width: 80rem;
  padding: 5rem 1rem;
}

@media (min-width: 640px) {
  .section-inner {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }
}

@media (min-width: 1024px) {
  .section-inner {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

.glass-panel {
  border: 1px solid var(--border);
  border-radius: 0.75rem !important;
  background: var(--panel);
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(18px);
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  border: 1px solid rgba(45, 212, 191, 0.28);
  border-radius: 9999px;
  background: rgba(45, 212, 191, 0.08);
  color: #7dd3fc;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  padding: 0.45rem 0.8rem;
  text-transform: uppercase;
}

.section-kicker::before {
  content: "";
  width: 0.45rem;
  height: 0.45rem;
  border-radius: 9999px;
  background: var(--accent);
  box-shadow: 0 0 18px rgba(45, 212, 191, 0.8);
}

.section-title {
  color: #f8fafc;
  font-size: clamp(2.1rem, 4vw, 4.25rem);
  font-weight: 800;
  line-height: 1.02;
}

.section-copy {
  color: var(--text-secondary);
  font-size: clamp(1rem, 2vw, 1.12rem);
  line-height: 1.75;
}

.button-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  border-radius: 0.75rem;
  background: var(--accent);
  box-shadow: 0 18px 36px rgba(20, 184, 166, 0.18);
  color: #04111d;
  font-weight: 800;
  padding: 0.85rem 1.15rem;
}

.button-primary:hover {
  background: #5eead4;
  transform: translateY(-2px);
}

.button-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  background: rgba(15, 23, 42, 0.72);
  color: #e2e8f0;
  font-weight: 800;
  padding: 0.85rem 1.15rem;
}

.button-secondary:hover {
  border-color: rgba(45, 212, 191, 0.45);
  color: #ffffff;
  transform: translateY(-2px);
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid var(--border);
  border-radius: 9999px;
  background: rgba(15, 23, 42, 0.7);
  color: #cbd5e1;
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.4rem 0.75rem;
}

.input-shell {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  background: rgba(2, 6, 23, 0.42);
  color: #f8fafc;
  outline: none;
  padding: 0.95rem 1rem;
}

.input-shell::placeholder {
  color: #64748b;
}

.input-shell:focus {
  border-color: rgba(45, 212, 191, 0.64);
  box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.12);
}

.progress-track {
  overflow: hidden;
  border-radius: 9999px;
  background: rgba(148, 163, 184, 0.16);
}

.text-balance {
  text-wrap: balance;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
